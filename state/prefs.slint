// Persistent user preferences (SlintLu Store). Change them with Store.set-* and every window
// follows.

import { Store } from "@slintlu";

export global Prefs {
    out property <string> wallpaper: Store.get-string("wallpaper", "", Store.revision);
    out property <string> wallpaper-dir: Store.get-string("wallpaper-dir", "~/Pictures/Wallpapers", Store.revision);
    out property <bool> dock: Store.get-bool("dock", true, Store.revision);
    out property <[string]> pinned: Store.get-list("dock-pinned", Store.revision);
    out property <bool> clock-24h: Store.get-bool("clock-24h", true, Store.revision);
    out property <bool> clock-seconds: Store.get-bool("clock-seconds", false, Store.revision);
    out property <bool> desktop-clock: Store.get-bool("desktop-clock", true, Store.revision);
    out property <bool> animations: Store.get-bool("animations", true, Store.revision);
    out property <bool> transparency: Store.get-bool("transparency", true, Store.revision);
    out property <bool> toasts: Store.get-bool("toasts", true, Store.revision);
    out property <bool> week-starts-monday: Store.get-bool("week-starts-monday", false, Store.revision);
    out property <int> lock-after-minutes: Store.get-number("lock-after-minutes", 10, Store.revision);
    // "auto", "dark" or "light", and a palette name ("" for the LunaDash palettes).
    out property <string> theme-mode: Store.get-string("theme-mode", "auto", Store.revision);
    out property <string> palette: Store.get-string("palette", "", Store.revision);
    out property <string> language: Store.get-string("language", "", Store.revision);
    out property <int> toast-seconds: Store.get-number("toast-seconds", 5, Store.revision);
    out property <bool> lock-before-sleep: Store.get-bool("lock-before-sleep", true, Store.revision);
    out property <bool> welcome-done: Store.get-bool("welcome-done", false, Store.revision);
}
