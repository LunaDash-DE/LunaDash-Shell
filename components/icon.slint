// Icons drawn for LunaDash (assets/icons). Generated by scripts/gen-icons.py.

export component Icon inherits Image {
    in property <string> name;
    in property <color> color: white;
    colorize: root.color;
    image-fit: contain;
    width: 20px;
    height: 20px;
    source:
        root.name == "apps" ? @image-url("../assets/icons/apps.svg") :
        root.name == "battery" ? @image-url("../assets/icons/battery.svg") :
        root.name == "battery-charging" ? @image-url("../assets/icons/battery-charging.svg") :
        root.name == "bell" ? @image-url("../assets/icons/bell.svg") :
        root.name == "bell-off" ? @image-url("../assets/icons/bell-off.svg") :
        root.name == "bluetooth" ? @image-url("../assets/icons/bluetooth.svg") :
        root.name == "brightness" ? @image-url("../assets/icons/brightness.svg") :
        root.name == "calendar" ? @image-url("../assets/icons/calendar.svg") :
        root.name == "check" ? @image-url("../assets/icons/check.svg") :
        root.name == "chevron-down" ? @image-url("../assets/icons/chevron-down.svg") :
        root.name == "chevron-left" ? @image-url("../assets/icons/chevron-left.svg") :
        root.name == "chevron-right" ? @image-url("../assets/icons/chevron-right.svg") :
        root.name == "clipboard" ? @image-url("../assets/icons/clipboard.svg") :
        root.name == "close" ? @image-url("../assets/icons/close.svg") :
        root.name == "coffee" ? @image-url("../assets/icons/coffee.svg") :
        root.name == "cpu" ? @image-url("../assets/icons/cpu.svg") :
        root.name == "dashboard" ? @image-url("../assets/icons/dashboard.svg") :
        root.name == "diamond" ? @image-url("../assets/icons/diamond.svg") :
        root.name == "disk" ? @image-url("../assets/icons/disk.svg") :
        root.name == "dock" ? @image-url("../assets/icons/dock.svg") :
        root.name == "ethernet" ? @image-url("../assets/icons/ethernet.svg") :
        root.name == "folder" ? @image-url("../assets/icons/folder.svg") :
        root.name == "globe" ? @image-url("../assets/icons/globe.svg") :
        root.name == "image" ? @image-url("../assets/icons/image.svg") :
        root.name == "info" ? @image-url("../assets/icons/info.svg") :
        root.name == "keyboard" ? @image-url("../assets/icons/keyboard.svg") :
        root.name == "language" ? @image-url("../assets/icons/language.svg") :
        root.name == "lock" ? @image-url("../assets/icons/lock.svg") :
        root.name == "logout" ? @image-url("../assets/icons/logout.svg") :
        root.name == "luna" ? @image-url("../assets/icons/luna.svg") :
        root.name == "memory" ? @image-url("../assets/icons/memory.svg") :
        root.name == "mic" ? @image-url("../assets/icons/mic.svg") :
        root.name == "minus" ? @image-url("../assets/icons/minus.svg") :
        root.name == "moon" ? @image-url("../assets/icons/moon.svg") :
        root.name == "music" ? @image-url("../assets/icons/music.svg") :
        root.name == "network" ? @image-url("../assets/icons/network.svg") :
        root.name == "next" ? @image-url("../assets/icons/next.svg") :
        root.name == "palette" ? @image-url("../assets/icons/palette.svg") :
        root.name == "panel" ? @image-url("../assets/icons/panel.svg") :
        root.name == "pause" ? @image-url("../assets/icons/pause.svg") :
        root.name == "play" ? @image-url("../assets/icons/play.svg") :
        root.name == "plus" ? @image-url("../assets/icons/plus.svg") :
        root.name == "power" ? @image-url("../assets/icons/power.svg") :
        root.name == "previous" ? @image-url("../assets/icons/previous.svg") :
        root.name == "reboot" ? @image-url("../assets/icons/reboot.svg") :
        root.name == "screenshot" ? @image-url("../assets/icons/screenshot.svg") :
        root.name == "search" ? @image-url("../assets/icons/search.svg") :
        root.name == "settings" ? @image-url("../assets/icons/settings.svg") :
        root.name == "sleep" ? @image-url("../assets/icons/sleep.svg") :
        root.name == "sun" ? @image-url("../assets/icons/sun.svg") :
        root.name == "terminal" ? @image-url("../assets/icons/terminal.svg") :
        root.name == "thermometer" ? @image-url("../assets/icons/thermometer.svg") :
        root.name == "trash" ? @image-url("../assets/icons/trash.svg") :
        root.name == "user" ? @image-url("../assets/icons/user.svg") :
        root.name == "volume" ? @image-url("../assets/icons/volume.svg") :
        root.name == "volume-low" ? @image-url("../assets/icons/volume-low.svg") :
        root.name == "volume-mute" ? @image-url("../assets/icons/volume-mute.svg") :
        root.name == "warning" ? @image-url("../assets/icons/warning.svg") :
        root.name == "wifi" ? @image-url("../assets/icons/wifi.svg") :
        root.name == "wifi-off" ? @image-url("../assets/icons/wifi-off.svg") :
        root.name == "workspace" ? @image-url("../assets/icons/workspace.svg") :
        @image-url("../assets/icons/info.svg");
}
