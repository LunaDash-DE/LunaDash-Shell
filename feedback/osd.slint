// On-screen display for volume and brightness changes.

import { PanelWindow, Layer, ExclusiveMode, Audio, Brightness } from "@slintlu";
import { Style } from "../style/style.slint";
import { UI } from "../state/ui.slint";
import { Icon } from "../components/icon.slint";

export component Osd inherits PanelWindow {
    namespace: "lunadash-osd";
    layer: Layer.overlay;
    exclusive-mode: ExclusiveMode.ignore;
    anchor-bottom: true;
    margin-bottom: 110px;
    preferred-width: 300px;
    preferred-height: 56px;
    shown: root.visible-now && UI.on-active-screen;
    default-font-family: Style.font;

    property <bool> visible-now;
    // Startup values arrive as changes too: ignore them for a moment.
    property <bool> armed;
    property <string> kind: "volume";
    property <float> volume: Audio.output.volume;
    property <bool> muted: Audio.output.muted;
    property <float> brightness: Brightness.level;

    function show(kind: string) {
        if !root.armed { return; }
        root.kind = kind;
        root.visible-now = true;
        hide-timer.running = false;
        hide-timer.running = true;
    }
    changed volume => { root.show("volume"); }
    changed muted => { root.show("volume"); }
    changed brightness => { root.show("brightness"); }

    Timer { interval: 3s; running: !root.armed; triggered => { root.armed = true; self.running = false; } }
    hide-timer := Timer { interval: 1500ms; running: false; triggered => { root.visible-now = false; self.running = false; } }

    property <float> value: root.kind == "volume" ? (root.muted ? 0 : root.volume) : root.brightness;
    Rectangle {
        border-radius: 28px;
        background: Style.glass-strong;
        border-width: 1px;
        border-color: Style.hairline;
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            spacing: 14px;
            Icon {
                name: root.kind == "brightness" ? "brightness" : root.muted ? "volume-mute" : root.volume < 0.4 ? "volume-low" : "volume";
                width: 22px;
                height: 22px;
                y: (parent.height - self.height) / 2;
                color: Style.text;
            }
            Rectangle {
                height: 8px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                background: Style.elevated;
                Rectangle {
                    x: 0;
                    width: parent.width * clamp(root.value, 0, 1);
                    border-radius: 4px;
                    background: root.value > 1 ? Style.warning : Style.accent;
                    animate width { duration: Style.motion-fast; }
                }
            }
            Text {
                width: 42px;
                text: Math.round(root.value * 100) + "%";
                color: Style.text;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }
}
